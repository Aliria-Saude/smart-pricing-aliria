rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Função auxiliar: verifica se o usuário está autenticado
    function isAuth() {
      return request.auth != null;
    }

    // ── Produtos (precos_compra)
    match /precos_compra/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Pregões
    match /pregoes/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Itens de pregão
    match /pregao_itens/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ── Auditoria: qualquer auth pode inserir, mas só lê o próprio
    match /auditoria/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.user_id;
      allow update: if false;  // imutável
      allow delete: if false;  // imutável
    }

    // ── Tabela CMED (preços ANVISA)
    match /cmed/{docId} {
      allow read:   if isAuth();
      allow write:  if isAuth();
    }

    // ── Bloqueia qualquer outra coleção
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
